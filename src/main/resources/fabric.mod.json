{
	"schemaVersion": 1,
	"id": "resource-screening",
	"version": "${version}",
	"name": "Resource Screening",
	"description": "A Minecraft Java Mod made to make Resource Pack management much easier, for those who have many different resource packs at the same time",
	"authors": ["shushi93"],
	"contact": {
		"homepage": "https://modrinth.com/project/resource-screening",
		"sources": "https://github.com/shushi93/Resource-Screening/"
	},
	"license": "GPL-3.0",
	"icon": "assets/resource-screening/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["net.shushi93.resource.ResourceScreening"],
		"client": ["net.shushi93.resource.client.ResourceScreeningClient"],
		"fabric-datagen": [
			"net.shushi93.resource.client.ResourceScreeningDataGenerator"
		]
	},
	"mixins": [
		"resource-screening.mixins.json",
		{
			"config": "resource-screening.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}
